# ── Database ─────────────────────────────────────────────────────────────
# Neon Postgres (or any Postgres). Local dev: docker compose up -d → port 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/academy

# ── Auth (Better Auth) ───────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# Social login (legacy fb/google parity — set to enable the buttons' real flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Payments (gateway adapters activate when keys exist) ────────────────
# Stripe (dashboard → test mode keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal (REST app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox            # sandbox | live
# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

# ── AI (studio GPT assistant, spec §7.16) ───────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Storage (uploads, spec §4.4) ────────────────────────────────────────
# local = public/uploads on disk (default; self-hosted)
# s3    = S3/R2 branch in src/lib/storage.ts (implement presigned PUT)
STORAGE_DRIVER=local
# S3/R2 (when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Jobs / cron (spec §4.4) ─────────────────────────────────────────────
# GET /api/cron with header x-cron-secret (Vercel Cron, cron-job.org, …)
CRON_SECRET=

# ── Email (React Email + Resend; falls back to console logs) ───────────
RESEND_API_KEY=
EMAIL_FROM="Academy LMS <no-reply@example.com>"
# SMTP fallback (legacy smtp_* settings)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
